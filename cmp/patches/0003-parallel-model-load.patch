@@ -316,6 +323,36 @@ struct llama_file::impl {
         }
     }
 
+    void read_raw_at_unsafe(void * ptr, size_t len, size_t offset) {
+        if (len == 0) {
+            return;
+        }
+
+        const int read_fd = fd != -1 ? fd : ::fileno(fp);
+        size_t bytes_read = 0;
+        while (bytes_read < len) {
+            const ssize_t ret = ::pread(
+                read_fd,
+                reinterpret_cast<char *>(ptr) + bytes_read,
+                len - bytes_read,
+                (off_t) (offset + bytes_read));
+            if (ret == -1) {
+                if (errno == EINTR) {
+                    continue;
+                }
+                throw std::runtime_error(format("read error: %s", strerror(errno)));
+            }
+            if (ret == 0) {
+                if (offset + bytes_read == size) {
+                    std::memset(reinterpret_cast<char *>(ptr) + bytes_read, 0, len - bytes_read);
+                    return;
+                }
+                throw std::runtime_error("unexpectedly reached end of file");
+            }
+            bytes_read += (size_t) ret;
+        }
+    }
+
     void read_aligned_chunk(void * dest, size_t size) {
         size_t offset = tell();
         off_t aligned_offset = offset & ~(alignment - 1);
@@ -389,6 +426,7 @@ struct llama_file::impl {
     }
 
     size_t alignment = 1;
+    std::mutex read_at_mutex;
 
     FILE * fp{};
     size_t size{};
@@ -430,6 +468,9 @@ void llama_file::read_raw_unsafe(void * ptr, size_t len) { pimpl->read_raw(ptr,
 #else
 void llama_file::read_raw_unsafe(void * ptr, size_t len) { pimpl->read_raw_unsafe(ptr, len); }
 #endif
+void llama_file::read_raw_at_unsafe(void * ptr, size_t len, size_t offset) {
+    pimpl->read_raw_at_unsafe(ptr, len, offset);
+}
 
 uint32_t llama_file::read_u32() { return pimpl->read_u32(); }
 
