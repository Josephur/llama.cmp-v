+
     ggml_tensor * prev_ids_tensor = nullptr;
     std::vector<int32_t> ids;
     std::vector<ggml_bitset_t> used_ids;
@@ -1762,12 +1863,47 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
                 } else {
                     ggml_backend_synchronize(split_backend);
                 }
-                const bool bridge_copy = ggml_backend_sched_cuda_bridge_requested() &&
-                    split_backend->iface.cpy_tensor_async != NULL &&
-                    split_backend->iface.cpy_tensor_async(
-                        input_backend, split_backend, input, input_cpy);
-                if (!bridge_copy) {
-                    ggml_backend_tensor_copy(input, input_cpy);
+                const int64_t t_copy_0 = input_copy_timing ? ggml_time_us() : 0;
+                bool expanded = false;
+                if (device_mask_mode != 0) {
+                    ggml_backend_input_mask_hint hint;
+                    if (ggml_backend_take_input_mask_hint(input, hint)) {
+                        ggml_backend_expand_input_mask_t expand = ggml_backend_sched_get_mask_expander(split_backend);
+                        if (expand != NULL && expand(split_backend, input_cpy, hint.prefix_len.data(), hint.n_rows, hint.n_cols, hint.prefix_bits, hint.suffix_bits)) {
+                            expanded = true;
+                            mask_expanded_count += 1;
+                            mask_expanded_bytes += ggml_nbytes(input);
+                            if (device_mask_mode >= 2) {
+                                // validation: compare the device-expanded mask with the host mask bit for bit
+                                std::vector<uint8_t> check(ggml_nbytes(input));
+                                ggml_backend_synchronize(split_backend);
+                                ggml_backend_tensor_get(input_cpy, check.data(), 0, check.size());
+                                if (memcmp(check.data(), input->data, check.size()) != 0) {
+                                    mask_validate_bad += 1;
+                                    GGML_LOG_ERROR("%s: device mask mismatch for %s [%lld x %lld]\n", __func__, input->name, (long long) input->ne[0], (long long) input->ne[1]);
+                                }
