+        fprintf(stderr, "ggml_sched_input_copy graph=%llu splits=%d inputs=%zu bytes=%zu max_bytes=%zu copy_ms=%.3f submit_ms=%.3f mask_expanded=%zu mask_expanded_bytes=%zu mask_validate_bad=%zu\n",
+                (unsigned long long) input_copy_graph_seq, sched->n_splits, input_copy_count, input_copy_bytes,
+                input_copy_max_bytes, input_copy_us / 1000.0, (ggml_time_us() - t_splits_0) / 1000.0,
+                mask_expanded_count, mask_expanded_bytes, mask_validate_bad);
