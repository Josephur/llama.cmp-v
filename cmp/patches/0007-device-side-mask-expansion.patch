+                if (!expanded) {
+                    const bool bridge_copy = ggml_backend_sched_cuda_bridge_requested() &&
+                        split_backend->iface.cpy_tensor_async != NULL &&
+                        split_backend->iface.cpy_tensor_async(
+                            input_backend, split_backend, input, input_cpy);
+                    if (!bridge_copy) {
+                        ggml_backend_tensor_copy(input, input_cpy);
+                    }
+                }
+                if (input_copy_timing) {
+                    input_copy_us    += ggml_time_us() - t_copy_0;
+                    if (!expanded) {
+                        input_copy_bytes += ggml_nbytes(input);
+                        if (ggml_nbytes(input) > input_copy_max_bytes) {
+                            input_copy_max_bytes = ggml_nbytes(input);
+                        }
+                    }
+                    input_copy_count += 1;
                 }
             } else {
                 // wait for the split backend to finish using the input before overwriting it
@@ -1925,6 +2061,16 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
         prev_backend_id = split_backend_id;
     }
 
+    if (device_mask_mode != 0) {
+        ggml_backend_clear_all_input_mask_hints();
+    }
+    if (input_copy_timing) {
