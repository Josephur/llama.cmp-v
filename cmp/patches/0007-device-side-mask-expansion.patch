diff --git a/src/llama-memory-hybrid-idx.cpp b/src/llama-memory-hybrid-idx.cpp
index 93b468784..53ffec6fd 100644
--- a/src/llama-memory-hybrid-idx.cpp
+++ b/src/llama-memory-hybrid-idx.cpp
@@ -1,5 +1,7 @@
 #include "llama-memory-hybrid-idx.h"
 
+#include "llama-input-mask-hint.h"
+
 #include "llama-impl.h"
 #include "llama-batch.h"
 #include "llama-io.h"
@@ -676,4 +678,16 @@ void llama_memory_hybrid_idx_context::set_input_qsa(
     GGML_ASSERT(mem != nullptr);
 
     mem->set_input_qsa(cell_blk, blk_cells, blk_pos, bias, ubatch, ratio, blk_bias);
+
+    // Upstream moved the fill into the memory module; publish the hint after the
+    // delegated call, where `bias` is populated. The per-block bias rows are
+    // [visible-block prefix, always-visible tail].
+    if (blk_bias) {
+        const int64_t n_ns = cell_blk->ne[1];
+        if (n_ns == 1) {
+            const int64_t n_blocks = blk_pos->ne[0]/(4*n_ns);
+            const int64_t n_tps    = ubatch->n_tokens/n_ns;
+            llama_publish_input_mask_hint<float>(bias, n_tps, n_blocks);
+        }
+    }
 }
