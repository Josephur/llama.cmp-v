 ggml/src/ggml-backend.cpp       | 162 ++++++++++++++++++++++++++++++--
 src/llama-input-mask-hint.h     |  64 +++++++++++++
 src/llama-kv-cache.cpp          |  14 ++-
 src/llama-memory-hybrid-idx.cpp |  14 +++
 5 files changed, 251 insertions(+), 11 deletions(-)
 create mode 100644 src/llama-input-mask-hint.h

diff --git a/ggml/include/ggml-backend.h b/ggml/include/ggml-backend.h
index cc3f8cd36..7cca60b0d 100644
--- a/ggml/include/ggml-backend.h
+++ b/ggml/include/ggml-backend.h
@@ -70,6 +70,14 @@ extern "C" {
     // tensor copy between different backends
     GGML_API void ggml_backend_tensor_copy(const struct ggml_tensor * src, struct ggml_tensor * dst);
 
+    // Input-mask hint: declares that a [n_cols, n_rows] F16/F32 user-input tensor holds, per row,
+    // exactly `prefix_len[row]` leading elements equal to `prefix_value` followed by elements equal
+    // to `suffix_value` (each `ggml_type_size(tensor->type)` bytes, copied). A backend that can
+    // expand this on device (see "ggml_backend_expand_input_mask" proc address) skips the host copy.
+    GGML_API void ggml_backend_tensor_set_input_mask_hint(const struct ggml_tensor * tensor, const int32_t * prefix_len, int64_t n_rows, int64_t n_cols,
+                                                          const void * prefix_value, const void * suffix_value);
+    GGML_API void ggml_backend_tensor_clear_input_mask_hint(const struct ggml_tensor * tensor);
+
     //
     // Backend (stream)
     //
diff --git a/ggml/src/ggml-backend.cpp b/ggml/src/ggml-backend.cpp
index 6a5ebf747..0e4553ba6 100644
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -10,6 +10,7 @@
 
 #include "ggml-backend.h"
 #include "ggml-backend-impl.h"
+#include "ggml-research.h"
 #include "ggml-alloc.h"
 #include "ggml-impl.h"
 
@@ -20,6 +21,7 @@
 #include <stdlib.h>
 #include <string.h>
 #include <algorithm>
+#include <mutex>
 #include <unordered_map>
 #include <vector>
 
@@ -877,8 +879,94 @@ static void ggml_backend_sched_graph_inputs_grow(ggml_backend_sched_t sched) {
 
 // returns the priority of the backend, lower id is higher priority
 static bool ggml_backend_sched_cuda_bridge_requested() {
-    const char * value = getenv("GGML_CUDA_MAPPED_HOST_BRIDGE");
-    return value != NULL && strcmp(value, "1") == 0;
+    static ggml_research_cached_int selector;
+    return selector.get("GGML_CUDA_MAPPED_HOST_BRIDGE", 0) == 1;
+}
+
+// ---- input-mask hints (device-side mask expansion) ----
+
+struct ggml_backend_input_mask_hint {
+    std::vector<int32_t> prefix_len;
+    int64_t  n_rows = 0;
+    int64_t  n_cols = 0;
+    uint32_t prefix_bits = 0; // element bit pattern (F16 in the low 16 bits, F32 as is)
+    uint32_t suffix_bits = 0;
+};
+
+static std::mutex g_input_mask_hint_mutex;
+static std::unordered_map<const ggml_tensor *, ggml_backend_input_mask_hint> g_input_mask_hints;
+
+void ggml_backend_tensor_set_input_mask_hint(const struct ggml_tensor * tensor, const int32_t * prefix_len, int64_t n_rows, int64_t n_cols,
+                                             const void * prefix_value, const void * suffix_value) {
+    const size_t esz = ggml_type_size(tensor->type);
+    if (esz != 2 && esz != 4) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(g_input_mask_hint_mutex);
+    ggml_backend_input_mask_hint & hint = g_input_mask_hints[tensor];
+    hint.prefix_len.assign(prefix_len, prefix_len + n_rows);
+    hint.n_rows = n_rows;
+    hint.n_cols = n_cols;
+    hint.prefix_bits = 0;
+    hint.suffix_bits = 0;
+    memcpy(&hint.prefix_bits, prefix_value, esz);
+    memcpy(&hint.suffix_bits, suffix_value, esz);
+}
+
+void ggml_backend_tensor_clear_input_mask_hint(const struct ggml_tensor * tensor) {
+    std::lock_guard<std::mutex> lock(g_input_mask_hint_mutex);
+    g_input_mask_hints.erase(tensor);
+}
+
+// returns true and fills `hint` when a hint matching the tensor geometry exists (the entry is consumed)
+static bool ggml_backend_take_input_mask_hint(const struct ggml_tensor * tensor, ggml_backend_input_mask_hint & hint) {
+    std::lock_guard<std::mutex> lock(g_input_mask_hint_mutex);
+    auto it = g_input_mask_hints.find(tensor);
+    if (it == g_input_mask_hints.end()) {
+        return false;
+    }
+    const bool ok = (tensor->type == GGML_TYPE_F16 || tensor->type == GGML_TYPE_F32) && ggml_is_contiguous(tensor) &&
+        tensor->ne[0] == it->second.n_cols && tensor->ne[1] == it->second.n_rows &&
+        tensor->ne[2] == 1 && tensor->ne[3] == 1;
+    if (ok) {
+        // the same input is copied once per split backend: keep the hint for the whole graph compute
+        hint = it->second;
+    } else {
+        g_input_mask_hints.erase(it);
+    }
+    return ok;
+}
+
+// hints are valid for exactly one graph compute; the scheduler clears them afterwards so a reused
+// tensor address can never be expanded from a stale descriptor
+static void ggml_backend_clear_all_input_mask_hints() {
+    std::lock_guard<std::mutex> lock(g_input_mask_hint_mutex);
+    g_input_mask_hints.clear();
+}
+
+// 0 = off, 1 = expand on device, 2 = expand and validate against the host mask (runtime selector)
+static int ggml_backend_sched_device_mask_mode() {
+    static ggml_research_cached_int selector;
+    return selector.get("GGML_SCHED_DEVICE_MASK", 0);
+}
+
+static bool ggml_backend_sched_input_copy_timing_requested() {
+    static ggml_research_cached_int selector;
+    return selector.get("GGML_SCHED_INPUT_COPY_TIMING", 0) != 0;
+}
+
+typedef bool (*ggml_backend_expand_input_mask_t)(ggml_backend_t backend, struct ggml_tensor * dst, const int32_t * prefix_len, int64_t n_rows, int64_t n_cols, uint32_t prefix_bits, uint32_t suffix_bits);
+
+static ggml_backend_expand_input_mask_t ggml_backend_sched_get_mask_expander(ggml_backend_t backend) {
+    ggml_backend_dev_t dev = ggml_backend_get_device(backend);
+    if (dev == NULL) {
+        return NULL;
+    }
+    ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+    if (reg == NULL) {
+        return NULL;
+    }
+    return (ggml_backend_expand_input_mask_t) ggml_backend_reg_get_proc_address(reg, "ggml_backend_expand_input_mask");
 }
 
