+// MemAvailable of the host in bytes, or 0 when unknown (non-Linux)
+static size_t server_host_available_bytes() {
+#ifdef __linux__
+    FILE * f = fopen("/proc/meminfo", "r");
+    if (f == nullptr) {
+        return 0;
+    }
+    size_t res = 0;
+    char line[256];
+    while (fgets(line, sizeof(line), f) != nullptr) {
+        unsigned long long kib = 0;
+        if (sscanf(line, "MemAvailable: %llu kB", &kib) == 1) {
+            res = (size_t) kib * 1024ull;
+            break;
+        }
+    }
+    fclose(f);
+    return res;
+#else
+    return 0;
+#endif
+}
+
+// host memory that must stay available after saving a prompt cache entry
+// (default 1 GiB, override with LLAMA_SERVER_CACHE_HOST_RESERVE_MIB)
+static size_t server_host_reserve_bytes() {
+    static const size_t reserve = [] {
+        const char * env = ggml_research_getenv("LLAMA_SERVER_CACHE_HOST_RESERVE_MIB");
+        const long long mib = env != nullptr ? atoll(env) : 1024;
+        return (size_t) (mib < 0 ? 0 : mib) * 1024ull * 1024ull;
+    }();
+    return reserve;
+}
