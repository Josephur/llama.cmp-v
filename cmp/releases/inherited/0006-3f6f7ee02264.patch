+// Device-side expansion of a two-value input row set (causal KQ masks, sparse-attention block
+// biases): row r holds prefix_len[r] leading elements with bit pattern `prefix_bits` followed by
+// elements with `suffix_bits`. Bit patterns are copied verbatim, so the result is identical to the
+// host constructor's tensor. T is uint16_t (F16) or uint32_t (F32); two elements per store.
+template <typename T>
+static __global__ void ggml_cuda_expand_input_mask_kernel(T * __restrict__ dst, const int32_t * __restrict__ prefix_len,
+                                                          const int64_t n_rows, const int64_t n_cols,
+                                                          const uint32_t prefix_bits, const uint32_t suffix_bits) {
+    const int64_t row = blockIdx.y;
+    if (row >= n_rows) {
+        return;
+    }
+    const int32_t prefix = prefix_len[row];
+    const T a = (T) prefix_bits;
+    const T b = (T) suffix_bits;
+    T * dst_row = dst + row*n_cols;
+    for (int64_t c = 2*((int64_t) blockIdx.x*blockDim.x + threadIdx.x); c < n_cols; c += 2*(int64_t) gridDim.x*blockDim.x) {
+        // n_cols is even, so both lanes are in range
+        dst_row[c]     = c     < prefix ? a : b;
+        dst_row[c + 1] = c + 1 < prefix ? a : b;
+    }
+}
+
+static bool ggml_backend_cuda_expand_input_mask(ggml_backend_t backend, ggml_tensor * dst, const int32_t * prefix_len, int64_t n_rows, int64_t n_cols,
+                                                uint32_t prefix_bits, uint32_t suffix_bits) {
+    if (!ggml_backend_is_cuda(backend) || (dst->type != GGML_TYPE_F16 && dst->type != GGML_TYPE_F32) || !ggml_is_contiguous(dst) ||
+            dst->ne[0] != n_cols || dst->ne[1] != n_rows || dst->ne[2] != 1 || dst->ne[3] != 1 || n_cols % 2 != 0 || n_rows <= 0) {
+        return false;
+    }
+    ggml_backend_buffer_t buf = dst->view_src ? dst->view_src->buffer : dst->buffer;
+    if (buf == nullptr || !ggml_backend_buffer_is_cuda(buf)) {
+        return false;
+    }
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_backend_cuda_buffer_context * buf_ctx = (ggml_backend_cuda_buffer_context *) buf->context;
+    if (cuda_ctx->device != buf_ctx->device) {
+        return false;
+    }
+    ggml_cuda_set_device(cuda_ctx->device);
+    cudaStream_t stream = cuda_ctx->stream();
+
+    ggml_cuda_pool_alloc<int32_t> prefix_dev(cuda_ctx->pool(), (size_t) n_rows);
+    CUDA_CHECK(cudaMemcpyAsync(prefix_dev.get(), prefix_len, n_rows*sizeof(int32_t), cudaMemcpyHostToDevice, stream));
+
+    const int block = 256;
+    const int grid_x = (int) std::min<int64_t>((n_cols/2 + block - 1)/block, 1024);
+    const dim3 grid(grid_x, (unsigned) n_rows, 1);
+    if (dst->type == GGML_TYPE_F16) {
+        ggml_cuda_expand_input_mask_kernel<uint16_t><<<grid, block, 0, stream>>>((uint16_t *) dst->data, prefix_dev.get(), n_rows, n_cols, prefix_bits, suffix_bits);
+    } else {
