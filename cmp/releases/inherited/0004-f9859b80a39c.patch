+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+
+static constexpr int    GGML_CUDA_MAPPED_BRIDGE_SLOTS     = 4;
+static constexpr size_t GGML_CUDA_MAPPED_BRIDGE_MAX_BYTES = 64 * 1024 * 1024;
+
+struct ggml_cuda_mapped_bridge_slot {
+    uint8_t * host       = nullptr;
+    uint8_t * dev_src    = nullptr;
+    uint8_t * dev_dst    = nullptr;
+    size_t capacity      = 0;
+    size_t flag_offset   = 0;
+    cudaEvent_t dst_done = nullptr;
+    bool in_flight       = false;
+};
+
+struct ggml_cuda_mapped_bridge_pair {
+    int src_device = -1;
+    int dst_device = -1;
+    std::array<ggml_cuda_mapped_bridge_slot, GGML_CUDA_MAPPED_BRIDGE_SLOTS> slots;
+    uint32_t next_slot  = 0;
+    uint32_t next_token = 1;
+    bool unsupported    = false;
+};
+
+struct ggml_cuda_mapped_host_bridge {
+    explicit ggml_cuda_mapped_host_bridge(int src_device) : src_device(src_device) {}
+
+    int src_device;
+    std::mutex mutex;
+    std::array<ggml_cuda_mapped_bridge_pair, GGML_CUDA_MAX_DEVICES> pairs;
+};
+
+static std::mutex ggml_cuda_mapped_bridge_init_mutex;
+
+static bool ggml_cuda_mapped_bridge_requested() {
+    const char * value = std::getenv("GGML_CUDA_MAPPED_HOST_BRIDGE");
+    return value != nullptr && strcmp(value, "1") == 0;
+}
+
+static void ggml_cuda_mapped_bridge_wait_slot(
+        ggml_cuda_mapped_bridge_pair & pair,
+        ggml_cuda_mapped_bridge_slot & slot) {
+    if (!slot.in_flight) {
+        return;
+    }
+    ggml_cuda_set_device(pair.dst_device);
+    CUDA_CHECK(cudaEventSynchronize(slot.dst_done));
+    slot.in_flight = false;
+}
+
+static void ggml_cuda_mapped_bridge_release_slot(
+        ggml_cuda_mapped_bridge_pair & pair,
+        ggml_cuda_mapped_bridge_slot & slot) {
+    ggml_cuda_mapped_bridge_wait_slot(pair, slot);
+    if (slot.dst_done != nullptr) {
+        ggml_cuda_set_device(pair.dst_device);
+        CUDA_CHECK(cudaEventDestroy(slot.dst_done));
+    }
+    if (slot.host != nullptr) {
+        ggml_cuda_set_device(pair.src_device);
+        CUDA_CHECK(cudaFreeHost(slot.host));
+    }
+    slot = {};
+}
+
+static bool ggml_cuda_mapped_bridge_prepare_slot(
+        ggml_cuda_mapped_bridge_pair & pair,
+        ggml_cuda_mapped_bridge_slot & slot,
+        size_t nbytes) {
+    ggml_cuda_mapped_bridge_wait_slot(pair, slot);
+    if (slot.capacity >= nbytes) {
+        return true;
+    }
+    ggml_cuda_mapped_bridge_release_slot(pair, slot);
+
+    cudaDeviceProp src_prop = {};
+    cudaDeviceProp dst_prop = {};
+    cudaError_t status = cudaGetDeviceProperties(
+        &src_prop, ggml_cuda_get_physical_device(pair.src_device));
+    if (status == cudaSuccess) {
+        status = cudaGetDeviceProperties(
+            &dst_prop, ggml_cuda_get_physical_device(pair.dst_device));
+    }
+    if (status != cudaSuccess || !src_prop.canMapHostMemory || !dst_prop.canMapHostMemory) {
+        (void) cudaGetLastError();
+        pair.unsupported = true;
+        return false;
+    }
+
+    slot.flag_offset = (nbytes + 63) & ~(size_t) 63;
+    const size_t allocation_size = slot.flag_offset + 64;
+    ggml_cuda_set_device(pair.src_device);
+    status = cudaHostAlloc(
+        reinterpret_cast<void **>(&slot.host), allocation_size,
+        cudaHostAllocPortable | cudaHostAllocMapped);
+    if (status == cudaSuccess) {
+        status = cudaHostGetDevicePointer(
+            reinterpret_cast<void **>(&slot.dev_src), slot.host, 0);
+    }
+    if (status == cudaSuccess) {
+        ggml_cuda_set_device(pair.dst_device);
+        status = cudaHostGetDevicePointer(
+            reinterpret_cast<void **>(&slot.dev_dst), slot.host, 0);
+    }
+    if (status == cudaSuccess) {
+        ggml_cuda_set_device(pair.src_device);
+        status = cudaMemset(slot.dev_src + slot.flag_offset, 0, sizeof(uint32_t));
+    }
+    if (status == cudaSuccess) {
+        ggml_cuda_set_device(pair.dst_device);
+        status = cudaEventCreateWithFlags(&slot.dst_done, cudaEventDisableTiming);
+    }
+    if (status != cudaSuccess) {
+        (void) cudaGetLastError();
+        ggml_cuda_mapped_bridge_release_slot(pair, slot);
+        pair.unsupported = true;
+        return false;
+    }
+
+    slot.capacity = nbytes;
+    return true;
+}
+
+static __global__ void ggml_cuda_mapped_bridge_store(
+        const uint8_t * src,
+        uint8_t * mapped,
+        size_t nbytes) {
+    const size_t tid = (size_t) blockIdx.x * blockDim.x + threadIdx.x;
+    const size_t stride = (size_t) gridDim.x * blockDim.x;
+    const bool aligned = ((reinterpret_cast<uintptr_t>(src) |
+                           reinterpret_cast<uintptr_t>(mapped)) & (alignof(uint4) - 1)) == 0;
+    if (aligned) {
+        const size_t n_vec = nbytes / sizeof(uint4);
+        for (size_t i = tid; i < n_vec; i += stride) {
+            reinterpret_cast<uint4 *>(mapped)[i] = reinterpret_cast<const uint4 *>(src)[i];
+        }
+        for (size_t i = n_vec * sizeof(uint4) + tid; i < nbytes; i += stride) {
+            mapped[i] = src[i];
+        }
+    } else {
+        for (size_t i = tid; i < nbytes; i += stride) {
+            mapped[i] = src[i];
+        }
+    }
+    __threadfence_system();
+}
+
+static __global__ void ggml_cuda_mapped_bridge_signal(uint32_t * signal, uint32_t token) {
+    __threadfence_system();
+    *reinterpret_cast<volatile uint32_t *>(signal) = token;
+    __threadfence_system();
+}
+
+static __global__ void ggml_cuda_mapped_bridge_wait(const uint32_t * signal, uint32_t token) {
+    while (*reinterpret_cast<const volatile uint32_t *>(signal) != token) {
+#if __CUDA_ARCH__ >= GGML_CUDA_CC_VOLTA
+        __nanosleep(100);
+#endif
+    }
+    __threadfence_system();
+}
+
+static __global__ void ggml_cuda_mapped_bridge_load(
+        const uint8_t * mapped,
+        uint8_t * dst,
+        size_t nbytes) {
+    const size_t tid = (size_t) blockIdx.x * blockDim.x + threadIdx.x;
+    const size_t stride = (size_t) gridDim.x * blockDim.x;
+    const bool aligned = ((reinterpret_cast<uintptr_t>(mapped) |
+                           reinterpret_cast<uintptr_t>(dst)) & (alignof(uint4) - 1)) == 0;
+    if (aligned) {
+        const size_t n_vec = nbytes / sizeof(uint4);
+        for (size_t i = tid; i < n_vec; i += stride) {
+            reinterpret_cast<uint4 *>(dst)[i] = reinterpret_cast<const uint4 *>(mapped)[i];
+        }
+        for (size_t i = n_vec * sizeof(uint4) + tid; i < nbytes; i += stride) {
+            dst[i] = mapped[i];
+        }
+    } else {
+        for (size_t i = tid; i < nbytes; i += stride) {
+            dst[i] = mapped[i];
+        }
+    }
+}
+
+static ggml_cuda_mapped_host_bridge * ggml_cuda_mapped_bridge_get(
+        ggml_backend_cuda_context * src_ctx) {
+    if (src_ctx->mapped_host_bridge == nullptr) {
+        std::lock_guard<std::mutex> lock(ggml_cuda_mapped_bridge_init_mutex);
+        if (src_ctx->mapped_host_bridge == nullptr) {
+            src_ctx->mapped_host_bridge = new ggml_cuda_mapped_host_bridge(src_ctx->device);
+        }
+    }
+    return src_ctx->mapped_host_bridge;
+}
+
+static bool ggml_cuda_mapped_bridge_copy(
+        ggml_backend_cuda_context * src_ctx,
+        ggml_backend_cuda_context * dst_ctx,
+        const ggml_tensor * src,
+        ggml_tensor * dst) {
+    const size_t nbytes = ggml_nbytes(dst);
+    if (nbytes == 0 || nbytes > GGML_CUDA_MAPPED_BRIDGE_MAX_BYTES ||
+        dst_ctx->device < 0 || dst_ctx->device >= GGML_CUDA_MAX_DEVICES) {
+        return false;
+    }
+
+    ggml_cuda_mapped_host_bridge * bridge = ggml_cuda_mapped_bridge_get(src_ctx);
+    std::lock_guard<std::mutex> lock(bridge->mutex);
+    ggml_cuda_mapped_bridge_pair & pair = bridge->pairs[dst_ctx->device];
+    pair.src_device = src_ctx->device;
+    pair.dst_device = dst_ctx->device;
+    if (pair.unsupported) {
+        return false;
+    }
+
+    ggml_cuda_mapped_bridge_slot & slot =
+        pair.slots[pair.next_slot++ % GGML_CUDA_MAPPED_BRIDGE_SLOTS];
+    if (!ggml_cuda_mapped_bridge_prepare_slot(pair, slot, nbytes)) {
+        return false;
+    }
+
+    if (pair.next_token == 0) {
+        for (auto & reset_slot : pair.slots) {
+            ggml_cuda_mapped_bridge_wait_slot(pair, reset_slot);
+            if (reset_slot.dev_src != nullptr) {
+                ggml_cuda_set_device(pair.src_device);
+                CUDA_CHECK(cudaMemset(
+                    reset_slot.dev_src + reset_slot.flag_offset, 0, sizeof(uint32_t)));
+            }
+        }
+        pair.next_token = 1;
+    }
+    const uint32_t token = pair.next_token++;
+
+    const int threads = 256;
+    const size_t work_items = (nbytes + sizeof(uint4) - 1) / sizeof(uint4);
+    const int blocks = (int) std::min<size_t>(
+        1024, std::max<size_t>(1, (work_items + threads - 1) / threads));
+
+    ggml_cuda_set_device(src_ctx->device);
+    ggml_cuda_mapped_bridge_store<<<blocks, threads, 0, src_ctx->stream()>>>(
+        static_cast<const uint8_t *>(src->data), slot.dev_src, nbytes);
+    ggml_cuda_mapped_bridge_signal<<<1, 1, 0, src_ctx->stream()>>>(
+        reinterpret_cast<uint32_t *>(slot.dev_src + slot.flag_offset), token);
+    CUDA_CHECK(cudaGetLastError());
+
+    ggml_cuda_set_device(dst_ctx->device);
+    ggml_cuda_mapped_bridge_wait<<<1, 1, 0, dst_ctx->stream()>>>(
+        reinterpret_cast<const uint32_t *>(slot.dev_dst + slot.flag_offset), token);
+    ggml_cuda_mapped_bridge_load<<<blocks, threads, 0, dst_ctx->stream()>>>(
+        slot.dev_dst, static_cast<uint8_t *>(dst->data), nbytes);
+    CUDA_CHECK(cudaGetLastError());
+    CUDA_CHECK(cudaEventRecord(slot.dst_done, dst_ctx->stream()));
+    slot.in_flight = true;
+    return true;
+}
+
+static void ggml_cuda_mapped_host_bridge_free(ggml_cuda_mapped_host_bridge * bridge) {
+    if (bridge == nullptr) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lock(bridge->mutex);
+        for (auto & pair : bridge->pairs) {
+            if (pair.src_device < 0 || pair.dst_device < 0) {
+                continue;
+            }
+            for (auto & slot : pair.slots) {
+                ggml_cuda_mapped_bridge_release_slot(pair, slot);
+            }
+        }
+    }
+    delete bridge;
+}
+
+#else
+
+struct ggml_cuda_mapped_host_bridge {};
+
+static void ggml_cuda_mapped_host_bridge_free(ggml_cuda_mapped_host_bridge * bridge) {
+    delete bridge;
+}
+
+#endif
