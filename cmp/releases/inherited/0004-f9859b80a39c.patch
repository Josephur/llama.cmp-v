+static int ggml_backend_sched_cuda_owner_from_static_source(
+        ggml_backend_sched_t sched,
+        const struct ggml_tensor * op) {
+    if (!ggml_backend_sched_cuda_bridge_requested() || op == NULL) {
+        return -1;
+    }
+
+    for (int i = 0; i < GGML_MAX_SRC; ++i) {
+        const struct ggml_tensor * src = op->src[i];
+        if (src == NULL) {
+            continue;
+        }
+        while (src->view_src != NULL) {
+            src = src->view_src;
+        }
+        if (src->op == GGML_OP_NONE && src->buffer != NULL) {
+            const int owner = ggml_backend_sched_backend_from_buffer(sched, src, op);
+            if (owner != -1) {
+                return owner;
+            }
+        }
+    }
+    return -1;
+}
