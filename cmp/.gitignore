# Portal build output and local tooling. Everything here is regenerable.

/site/
/.venv/
__pycache__/

# Per-run benchmark artifacts: prompts, SSE event logs and raw responses.
# They are large, they are model output rather than measurement, and they can
# echo host paths back from a prompt. Only the derived CSVs under
# docs/results/data/ are published.
/docs/results/raw/

# Benchmark CSVs are published deliberately, not by existing. A run in flight
# appends to its file for hours; if that path were tracked by default the
# working tree would be dirty for the whole run and the workspace audit would
# fail on a benchmark doing exactly what it is supposed to do.
#
# When a run has completed and its rows are verified, publish it:
#
#   git add -f cmp/docs/results/data/<run>.csv
#
# A published CSV is then tracked and diffs normally. Never append to one: a
# rerun writes a new dated filename, so a published number never moves.
/docs/results/data/*.csv
!/docs/results/data/sm70-d256-shared-q-20260907.csv
!/docs/results/data/sm70-d256-shared-q-unit-scale-20260907.csv

# Run-specific copies of the benchmark scripts. The tracked scripts end in
# .example.sh and are generic by construction: they read every host, device,
# path, port, service and model name from target.toml, so they can be published
# without describing anyone's machine. A real run rarely survives contact with
# that purity -- an operator wants a hardcoded package pair for the afternoon, a
# shortened ladder, a one-off flag -- and the honest place for that is a copy,
# not an edit to the tracked file.
#
#   cp cmp/scripts/benchmark-baseline.example.sh cmp/scripts/local/tuesday.sh
#
# Ignoring this directory serves two purposes at once. It keeps local details
# out of the published repository, and it keeps them out of the way of the next
# agent, who would otherwise have to work out which of several near-identical
# scripts is the one to copy. There is exactly one script to copy: the .example.
#
# Only the directory's contents are ignored, so README.md below still tracks and
# the directory exists in a fresh clone. Anything else added here is invisible
# to git on purpose; if a local script becomes generally useful, fold it back
# into the .example.sh rather than adding an exception for it.
/scripts/local/*
!/scripts/local/README.md
